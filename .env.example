OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4.1

# Clerk (auth identity only — AthleteOS permissions live in Postgres)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# Neon Postgres (system of record)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# AthleteOS environment separation (pilot safety)
# development | preview | production
ATHLETEOS_ENV=development
# Temporary: required to migrate when ATHLETEOS_ENV=production (unset after success)
# ATHLETEOS_ALLOW_PROD_MIGRATE=1
# Temporary: required to migrate against any neon.tech URL from local/dev (unset after success)
# ATHLETEOS_ALLOW_NEON_MIGRATE=1
# Required to hard-reset workspaces when ATHLETEOS_ENV=production
# ALLOW_PILOT_WORKSPACE_RESET=1

# Internal founder pilot dashboard (/admin/pilot)
# Comma-separated Clerk user IDs (server-only; never expose to client)
FOUNDER_CLERK_USER_IDS=
